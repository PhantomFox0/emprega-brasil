NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173, http://localhost:3001

# AWS RDS MySQL
DB_HOST=seu-banco.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=xxxxx
DB_NAME=perfil_db
# SSL ligado por padrão; use DB_SSL=false só para MySQL local (docker compose --profile local)
DB_SSL=true
DB_SSL_CA=certs/global-bundle.pem
# Usado apenas pelo MySQL local do docker-compose
DB_ROOT_PASSWORD=xxxxx

JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h
